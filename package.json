{
  "name": "full-stack-project",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "dependencies": {
    "typescript": "5.9.2",
    "@nestjs/mongoose": "^11.0.1",
    "mongoose": "^7.3.4"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
