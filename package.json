{
  "name": "full-stack-project",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run start:dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "prettier": "3.4.2",
    "turbo": "2.9.14"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@apollo/server": "5.5.1"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.4"
  }
}
