{
  "name": "full-stack-project",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run start:dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "24.12.4",
    "prettier": "3.4.2",
    "turbo": "2.9.14"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@apollo/server": "5.5.1",
    "@nestjs/common": "11.0.1",
    "@types/express": "5.0.0",
    "rxjs": "7.8.1"
  },
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/config": "4.0.4",
    "js-cookie": "^3.0.8",
    "react-cookie": "^8.1.2"
  }
}
